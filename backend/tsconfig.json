{
  "compilerOptions": {
    "target": "es2022",                                  /* Wersja docelowego ECMAScript */
    "module": "commonjs",                                /* Moduły dla Node.js */
    "rootDir": "./src",                                  /* Tu leży nasz kod źródłowy */
    "outDir": "./dist",                                  /* Tu trafi skompilowany kod */
    "esModuleInterop": true,                             /* KLUCZOWE: Naprawia błędy z importami Expressa */
    "forceConsistentCasingInFileNames": true,            /* Wymusza spójność wielkości liter w ścieżkach */
    "strict": true,                                      /* Ścisłe sprawdzanie typów */
    "skipLibCheck": true                                 /* Przyspiesza kompilację, pomijając sprawdzanie typów w node_modules */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}